{
	"name": "My Game",
	"start_scene": "@game/Scenes/Main.scene",
	"window_width": 1600,
	"window_height": 900,
	"window_icon": "@game/App/window_icon.png",
	"fullscreen": false,
	"vsync": true,
	"collision_layers": {
		"Environment": 0,
		"Player": 1,
		"Enemy": 2,
		"PlayerHitbox": 3,
		"EnemyHitbox": 4,
		"Trigger": 5
	},
	"collision_matrix": [
		"Environment + Environment",
		"Environment + Player",
		"Environment + Enemy",
		"Player + Player",
		"Player + Enemy",
		"Player + EnemyHitbox",
		"Player + Trigger",
		"Enemy + Enemy",
		"Enemy + PlayerHitbox",
		"Enemy + Trigger"
	]
}
